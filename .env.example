# Google Gemini API key. Required for live AI search, chat, photo listings,
# and seller copy. Without it, those routes use the built-in mock provider.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional public URL of this deployment (self-referential links).
APP_URL=

# Local Express port. Default is 3000.
PORT=3000

# development or production
NODE_ENV=development

# Set to true to disable Vite HMR (used by some hosted editors).
DISABLE_HMR=

# Scraper settings used by `npm run import:olx` and `car scraper/main.py`.
OLX_URL=https://www.olx.com.pk/cars_c84
OLX_MORE=100
OLX_ADS_LIMIT=100
HEADLESS=1
MAX_IMAGES=6
REQUEST_DELAY=1.5
